{
  "productName": "Velocity",
  "version": "1.1.2",
  "identifier": "com.chazq.velocity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
  "windows": [
    {
      "title": "Velocity",
      "width": 400,
      "height": 620,
      "minWidth": 400,
      "minHeight": 620,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "decorations": false,
      "transparent": false,
      "backgroundColor": "#050505"
    }
  ]
},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*",
      "bin/lists/*"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "both" }
    }
  }
}